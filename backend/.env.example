# ===================================
# CASHORA BACKEND - Environment Variables
# ===================================

# Server Configuration
NODE_ENV=development
PORT=4000

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Session Secret (CHANGE THIS IN PRODUCTION!)
SESSION_SECRET=your-super-secret-key-change-in-production-min-32-chars

# Supabase Database
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# n8n Webhook (for video processing automation)
N8N_WEBHOOK_URL=https://your-n8n-webhook-url

# AI/LLM API Keys (for caption improvement - choose one or more)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Alternative LLM Providers
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google OAuth (for YouTube integration)
# NOTE: the code reads YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET / YOUTUBE_REDIRECT_URI
# (not GOOGLE_*) — use these exact names or the YouTube OAuth flow silently fails.
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=https://cashora-backend-1w64.onrender.com/auth/youtube/callback

# Pixabay API (for stock images/videos)
PIXABAY_API_KEY=your-pixabay-api-key

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Threads API
# Current code only uses ACCESS_TOKEN/USER_ID/USERNAME (manual long-lived token,
# no OAuth exchange implemented yet). APP_ID/APP_SECRET are reserved for that.
THREADS_ACCESS_TOKEN=your-threads-access-token
THREADS_USER_ID=your-threads-user-id
THREADS_USERNAME=your-threads-username
THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret

# Twitter/X API (optional)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# Bluesky (optional)
BLUESKY_HANDLE=your-bluesky-handle
BLUESKY_APP_PASSWORD=your-bluesky-app-password

# Discord Bot
DISCORD_APP_ID=your-discord-app-id
DISCORD_PUBLIC_KEY=your-discord-public-key
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-server-id
DISCORD_CHANNEL_ID=your-discord-channel-id

# Blotato Video Generation API
BLOTATO_API_KEY=your-blotato-api-key

# Gemini API (for prompt enhancement and video generation)
GEMINI_API_KEY=your-gemini-api-key
